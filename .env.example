# ==============================================================================
# Dr. Surajit Sinha — Advocate, High Court & Lower Courts
# Environment Configuration Template (.env.example)
# ==============================================================================
# IMPORTANT: Copy this file to .env.local for local development.
# NEVER commit real credentials, production keys, or service role tokens to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Project Configuration
# ------------------------------------------------------------------------------
# Project URL located in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Public Anon Key: Safe for browser consumption. Governed by Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"

# Service Role Key: SECRET. Used strictly by server-side routes (/api/inquiry, admin sync).
# NEVER expose to client components or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# ------------------------------------------------------------------------------
# 2. Site Canonical URL & Deployment
# ------------------------------------------------------------------------------
# Canonical URL used for absolute OpenGraph, Schema.org, and sitemap generation.
NEXT_PUBLIC_SITE_URL="https://surojitsinha.com"

# ------------------------------------------------------------------------------
# 3. Security, Rate Limiting & Admin Controls
# ------------------------------------------------------------------------------
# Secret salt used for HMAC-SHA-256 IP hashing for privacy-preserving inquiry rate limits.
# Must be a long random string (e.g., generated with `openssl rand -hex 32`).
RATE_LIMIT_SECRET="a_secure_random_hex_string_32_bytes_or_more"

# Administrative Email Allowlist (Comma-separated list of pre-authorized chamber emails)
# Used as secondary verification alongside Supabase app_metadata.role = 'admin'.
ADMIN_EMAILS="chamber@surojitsinha.com,admin@surojitsinha.com"

# ------------------------------------------------------------------------------
# 4. First Administrator Provisioning Guide
# ------------------------------------------------------------------------------
# How to provision the first administrator account:
# 1. Go to your Supabase Dashboard -> Authentication -> Users.
# 2. Invite or create a user with the authorized email (e.g. chamber@surojitsinha.com).
# 3. In the SQL Editor, execute the following command to assign the 'admin' role in app_metadata:
#    UPDATE auth.users 
#    SET raw_app_meta_data = raw_app_meta_data || '{"role": "admin"}'::jsonb 
#    WHERE email = 'chamber@surojitsinha.com';
# 4. The user can now log in via /admin/login using their credentials.
# ------------------------------------------------------------------------------

